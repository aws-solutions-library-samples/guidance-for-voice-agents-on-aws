        <mxCell id="v2b1" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0972D4;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;fontFamily=Helvetica;" value="1" vertex="1">
