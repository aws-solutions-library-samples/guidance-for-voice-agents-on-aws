# Copy to .env and fill in. .env is gitignored; this file is not.
#
# AWS deploy order: infrastructure/scripts/deploy_office.sh ONCE first (needs only
# AGENT_EMAIL, below) to create OutboundIvrOfficeStack -- the mock provider's own
# Connect instance, front desk, and (normally) a claimed office DID. Then
# infrastructure/scripts/deploy.sh, which deploys OutboundIvrVoiceStack and
# OutboundIvrStack; OutboundIvrStack reads the Connect instance id and arn, the
# claimed office number, and the front-desk queue arn straight from SSM (published
# by OutboundIvrOfficeStack), so there is no OFFICE_NUMBER to set here any more,
# and no second deploy needed to pick up a claimed number.
# AWS_REGION is read directly (no fallback) by code that runs the agent or Lambdas
# outside AWS -- for example running outbound_ivr.voice.livekit_calls or
# src/agentcore/livekit_app.py against a local LiveKit server. Lambda and AgentCore
# Runtime set it automatically when deployed, so this only matters for local use.
AWS_REGION=us-east-1

# The 12-digit AWS account and the Region deploy.sh, deploy_office.sh, and
# deploy_flow.sh deploy into/operate on. All three refuse to run if either is unset,
# or (for the account) the live credentials are for a different account.
OUTBOUND_IVR_ACCOUNT_ID=
OUTBOUND_IVR_REGION=us-east-1

# The phone the mock provider IVR transfers to: whoever plays the front desk.
FRONT_DESK_NUMBER=+15555550100

# The mock office IVR flow's own id -- needed only for
# infrastructure/scripts/deploy_flow.sh's ad hoc push (regenerate
# infrastructure/connect/flows/ with infrastructure/connect/make_flow.py, then push
# just the updated content, skipping a full `cdk deploy`). OutboundIvrOfficeStack
# (infrastructure/stacks/office_stack.py) creates this flow directly inside the
# Connect instance it owns, substituting the real front-desk queue arn at deploy
# time -- so a normal `deploy_office.sh` already pushes current content and you
# never have to set this. Only fill it in for deploy_flow.sh's faster,
# CloudFormation-bypassing push: after a first deploy, find it with
# `aws connect list-contact-flows --instance-id <id>` (the instance id is
# published to SSM /outbound-ivr/connect/instance-id, not to .env).
MOCK_PROVIDER_FLOW_ID=

# LiveKit: only needed to run outbound_ivr.voice.livekit_calls /
# src/agentcore/livekit_app.py against a LiveKit server directly (e.g. for local
# testing against a real or self-hosted server). The deployed Runtime gets
# LIVEKIT_URL and the API key/secret from the CDK stack, not from this file.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
OUTBOUND_IVR_VOICE=amy
OUTBOUND_IVR_SONIC_MODEL=amazon.nova-2-5-sonic

# AWS deploy (deploy_office.sh and deploy.sh): the front desk and escalation
# agents' shared login email. Both scripts pass it as CDK context
# -c agentEmail=..., never commit a real address to cdk.context.json.
#
# No OFFICE_NUMBER here any more: deploy_office.sh claims the mock office's real
# Connect DID on its own (-c claimOfficeNumber=true, its own default), and
# OutboundIvrStack reads the result straight from SSM
# /outbound-ivr/connect/office-number at deploy time -- see deploy_office.sh's own
# header for the full SSM contract this replaces the old
# copy-the-number-into-.env-and-redeploy step with.
AGENT_EMAIL=you@example.com

# Where the stack's CloudWatch alarms send notifications. Optional: without it the
# alarms still exist and still go to ALARM in the console, and notify nobody. AWS
# emails one confirmation link to this address; it has to be clicked once before
# anything is delivered.
ALERT_EMAIL=you@example.com
# The Chime SDK number on the Voice Connector, used as outbound caller ID.
CALLER_ID_NUMBER=+15555550102
# Evidence team escalation: "direct" dials FRONT_DESK_NUMBER straight into the call
# as a live colleague; unset or "connect" (default) uses the Connect handoff-code queue.
EVIDENCE_MODE=direct
